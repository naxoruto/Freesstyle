generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ChallengeGame {
  FREESTYLER
  GRID
  DRAFT
}

enum ChallengeStatus {
  DRAFT
  VALIDATED
  PUBLISHED
}

enum ReviewStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum CatalogStatus {
  CANDIDATE
  PUBLISHED
  REJECTED
}

model Country {
  id          String       @id @default(cuid())
  code        String       @unique @db.VarChar(2)
  name        String       @unique
  flagEmoji   String?      @map("flag_emoji")
  freestylers Freestyler[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("countries")
}

model Freestyler {
  id                   String             @id @default(cuid())
  slug                 String             @unique
  alias                String
  normalizedAlias      String             @unique @map("normalized_alias")
  realName             String?            @map("real_name")
  countryId            String             @map("country_id")
  country              Country            @relation(fields: [countryId], references: [id])
  birthDate            DateTime?          @map("birth_date") @db.Date
  birthYear            Int?               @map("birth_year")
  debutYear            Int?               @map("debut_year")
  fmsParticipant       Boolean?           @map("fms_participant")
  redBullInternational Boolean?           @map("red_bull_international")
  catalogStatus        CatalogStatus      @default(CANDIDATE) @map("catalog_status")
  active               Boolean            @default(true)
  instagramUrl         String?            @map("instagram_url")
  youtubeUrl           String?            @map("youtube_url")
  verifiedAt           DateTime?          @map("verified_at")
  participations       Participation[]
  titles               Title[]
  battlesAsCompetitor1 Battle[]           @relation("BattleCompetitor1")
  battlesAsCompetitor2 Battle[]           @relation("BattleCompetitor2")
  battlesWon           Battle[]           @relation("BattleWinner")
  sources              FreestylerSource[]
  reviewIssues         DataReviewIssue[]
  styles               FreestylerStyle[]
  aliases              FreestylerAlias[]
  externalProfiles     ExternalProfile[]
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  @@index([alias])
  @@index([countryId])
  @@index([catalogStatus])
  @@map("freestylers")
}

model FreestylerAlias {
  id              String      @id @default(cuid())
  freestylerId    String      @map("freestyler_id")
  freestyler      Freestyler  @relation(fields: [freestylerId], references: [id], onDelete: Cascade)
  alias           String
  normalizedAlias String      @map("normalized_alias")
  sourceId        String?     @map("source_id")
  source          DataSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  createdAt       DateTime    @default(now()) @map("created_at")

  @@unique([freestylerId, normalizedAlias])
  @@index([normalizedAlias])
  @@index([sourceId])
  @@map("freestyler_aliases")
}

model Competition {
  id             String          @id @default(cuid())
  slug           String          @unique
  name           String
  organizer      String?
  international  Boolean         @default(false)
  seasons        Season[]
  participations Participation[]
  titles         Title[]
  battles        Battle[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("competitions")
}

model Season {
  id             String          @id @default(cuid())
  competitionId  String          @map("competition_id")
  competition    Competition     @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  name           String
  startYear      Int             @map("start_year")
  endYear        Int?            @map("end_year")
  participations Participation[]
  titles         Title[]
  battles        Battle[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@unique([competitionId, name])
  @@index([startYear])
  @@map("seasons")
}

model Participation {
  id            String      @id @default(cuid())
  freestylerId  String      @map("freestyler_id")
  freestyler    Freestyler  @relation(fields: [freestylerId], references: [id], onDelete: Cascade)
  competitionId String      @map("competition_id")
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  seasonId      String?     @map("season_id")
  season        Season?     @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  finalPosition Int?        @map("final_position")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@unique([freestylerId, competitionId, seasonId])
  @@index([competitionId])
  @@index([seasonId])
  @@map("participations")
}

model Title {
  id            String      @id @default(cuid())
  freestylerId  String      @map("freestyler_id")
  freestyler    Freestyler  @relation(fields: [freestylerId], references: [id], onDelete: Cascade)
  competitionId String      @map("competition_id")
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  seasonId      String?     @map("season_id")
  season        Season?     @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  label         String?
  wonAt         DateTime?   @map("won_at") @db.Date
  sourceId      String?     @map("source_id")
  source        DataSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now()) @map("created_at")

  @@unique([freestylerId, competitionId, seasonId, label])
  @@index([competitionId])
  @@index([sourceId])
  @@map("titles")
}

model Battle {
  id            String      @id @default(cuid())
  externalId    String?     @unique @map("external_id")
  competitor1Id String      @map("competitor_1_id")
  competitor1   Freestyler  @relation("BattleCompetitor1", fields: [competitor1Id], references: [id])
  competitor2Id String      @map("competitor_2_id")
  competitor2   Freestyler  @relation("BattleCompetitor2", fields: [competitor2Id], references: [id])
  winnerId      String?     @map("winner_id")
  winner        Freestyler? @relation("BattleWinner", fields: [winnerId], references: [id])
  competitionId String      @map("competition_id")
  competition   Competition @relation(fields: [competitionId], references: [id])
  seasonId      String?     @map("season_id")
  season        Season?     @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  stage         String?
  battleDate    DateTime?   @map("battle_date") @db.Date
  hadReplica    Boolean     @default(false) @map("had_replica")
  videoUrl      String?     @map("video_url")
  sourceId      String?     @map("source_id")
  source        DataSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([competitor1Id])
  @@index([competitor2Id])
  @@index([winnerId])
  @@index([competitionId, seasonId])
  @@map("battles")
}

model DataSource {
  id          String             @id @default(cuid())
  name        String
  url         String             @unique
  accessedAt  DateTime           @map("accessed_at")
  freestylers FreestylerSource[]
  titles      Title[]
  styles      FreestylerStyle[]
  aliases     FreestylerAlias[]
  battles     Battle[]
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@map("data_sources")
}

model FreestylerSource {
  freestylerId String     @map("freestyler_id")
  freestyler   Freestyler @relation(fields: [freestylerId], references: [id], onDelete: Cascade)
  sourceId     String     @map("source_id")
  source       DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([freestylerId, sourceId])
  @@map("freestyler_sources")
}

model StyleTag {
  id          String            @id @default(cuid())
  slug        String            @unique
  name        String
  description String?
  freestylers FreestylerStyle[]
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@map("style_tags")
}

model FreestylerStyle {
  freestylerId String     @map("freestyler_id")
  freestyler   Freestyler @relation(fields: [freestylerId], references: [id], onDelete: Cascade)
  styleTagId   String     @map("style_tag_id")
  styleTag     StyleTag   @relation(fields: [styleTagId], references: [id], onDelete: Cascade)
  rank         Int
  sourceId     String     @map("source_id")
  source       DataSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@id([freestylerId, styleTagId])
  @@unique([freestylerId, rank])
  @@index([styleTagId])
  @@index([sourceId])
  @@map("freestyler_styles")
}

model DataReviewIssue {
  id           String       @id @default(cuid())
  freestylerId String       @map("freestyler_id")
  freestyler   Freestyler   @relation(fields: [freestylerId], references: [id], onDelete: Cascade)
  key          String
  summary      String
  details      Json?
  status       ReviewStatus @default(OPEN)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@unique([freestylerId, key])
  @@index([status])
  @@map("data_review_issues")
}

model ImportRecord {
  key       String   @id
  source    String
  status    String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([source])
  @@map("import_records")
}

model CatalogImportRun {
  id              String            @id @default(cuid())
  provider        String
  kind            String
  status          String            @default("RUNNING")
  startedAt       DateTime          @default(now()) @map("started_at")
  completedAt     DateTime?         @map("completed_at")
  discoveredCount Int               @default(0) @map("discovered_count")
  fetchedCount    Int               @default(0) @map("fetched_count")
  parsedCount     Int               @default(0) @map("parsed_count")
  failedCount     Int               @default(0) @map("failed_count")
  metadata        Json?
  error           String?
  externalProfiles ExternalProfile[]

  @@index([provider, kind, status])
  @@map("catalog_import_runs")
}

model ExternalProfile {
  id                 String                  @id @default(cuid())
  provider           String
  externalId         String                  @map("external_id")
  canonicalUrl       String                  @map("canonical_url")
  sourceAlias        String                  @map("source_alias")
  normalizedAlias    String                  @map("normalized_alias")
  countryCode        String?                 @map("country_code") @db.VarChar(2)
  realName           String?                 @map("real_name")
  birthDate          DateTime?               @map("birth_date") @db.Date
  birthYear          Int?                    @map("birth_year")
  parseStatus        String                  @default("PARSED") @map("parse_status")
  contentHash        String?                 @map("content_hash")
  payload            Json?
  firstSeenAt        DateTime                @default(now()) @map("first_seen_at")
  lastSeenAt         DateTime                @default(now()) @map("last_seen_at")
  lastSeenRunId      String?                 @map("last_seen_run_id")
  lastSeenRun        CatalogImportRun?       @relation(fields: [lastSeenRunId], references: [id], onDelete: SetNull)
  linkedFreestylerId String?                 @map("linked_freestyler_id")
  linkedFreestyler   Freestyler?             @relation(fields: [linkedFreestylerId], references: [id], onDelete: SetNull)
  aliases            ExternalProfileAlias[]
  participations     ExternalParticipation[]
  wins               ExternalWin[]
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")

  @@unique([provider, externalId])
  @@index([provider, normalizedAlias])
  @@index([linkedFreestylerId])
  @@index([lastSeenRunId])
  @@map("external_profiles")
}

model ExternalProfileAlias {
  id                String          @id @default(cuid())
  externalProfileId String          @map("external_profile_id")
  externalProfile   ExternalProfile @relation(fields: [externalProfileId], references: [id], onDelete: Cascade)
  alias             String
  normalizedAlias   String          @map("normalized_alias")
  createdAt         DateTime        @default(now()) @map("created_at")

  @@unique([externalProfileId, normalizedAlias])
  @@index([normalizedAlias])
  @@map("external_profile_aliases")
}

model ExternalParticipation {
  id                    String          @id @default(cuid())
  externalProfileId     String          @map("external_profile_id")
  externalProfile       ExternalProfile @relation(fields: [externalProfileId], references: [id], onDelete: Cascade)
  competitionName       String          @map("competition_name")
  normalizedCompetition String          @map("normalized_competition")
  season                String?
  eventName             String?         @map("event_name")
  stage                 String?
  sourceUrl             String?         @map("source_url")
  createdAt             DateTime        @default(now()) @map("created_at")

  @@unique([externalProfileId, normalizedCompetition, season, eventName, stage])
  @@index([normalizedCompetition])
  @@map("external_participations")
}

model ExternalWin {
  id                    String          @id @default(cuid())
  externalProfileId     String          @map("external_profile_id")
  externalProfile       ExternalProfile @relation(fields: [externalProfileId], references: [id], onDelete: Cascade)
  competitionName       String          @map("competition_name")
  normalizedCompetition String          @map("normalized_competition")
  label                 String
  season                String?
  eventName             String?         @map("event_name")
  year                  Int?
  category              String          @default("OTHER")
  countsForDaily        Boolean         @default(false) @map("counts_for_daily")
  sourceUrl             String?         @map("source_url")
  createdAt             DateTime        @default(now()) @map("created_at")

  @@unique([externalProfileId, normalizedCompetition, label])
  @@index([normalizedCompetition])
  @@index([category, countsForDaily])
  @@map("external_wins")
}

model ExternalProfileCandidate {
  id              String   @id @default(cuid())
  source          String
  alias           String
  normalizedAlias String   @map("normalized_alias")
  profileUrl      String   @map("profile_url")
  countryCode     String?  @map("country_code")
  suggestedAlias  String?  @map("suggested_alias")
  status          String   @default("OPEN")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([source, normalizedAlias])
  @@index([status])
  @@map("external_profile_candidates")
}

model DailyChallenge {
  id          String          @id @default(cuid())
  game        ChallengeGame
  dateKey     String          @map("date_key") @db.VarChar(64)
  status      ChallengeStatus @default(DRAFT)
  payload     Json
  validatedAt DateTime?       @map("validated_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  attempts    GameAttempt[]

  @@unique([game, dateKey])
  @@index([status, dateKey])
  @@map("daily_challenges")
}

model GameAttempt {
  id           String         @id @default(cuid())
  challengeId  String         @map("challenge_id")
  challenge    DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  sessionHash  String         @map("session_hash")
  completed    Boolean        @default(false)
  won          Boolean?
  attemptCount Int            @default(0) @map("attempt_count")
  result       Json?
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@unique([challengeId, sessionHash])
  @@index([challengeId, completed])
  @@map("game_attempts")
}

model LiveBattle {
  id                String   @id
  modeConfig        Json     @map("mode_config")
  status            String   @default("lobby")
  currentRound      Int      @default(0) @map("current_round")
  roundPhase        String   @default("countdown") @map("round_phase")
  currentTurn       String   @default("") @map("current_turn")
  currentWord       Json?    @map("current_word")
  pendingEntry      Json?    @map("pending_entry")
  participantOrder  String[] @default([]) @map("participant_order")
  timeRemaining     Int      @default(0) @map("time_remaining")
  entriesRemaining  Json     @default("{}") @map("entries_remaining")
  totalScores       Json     @default("{}") @map("total_scores")
  turnSequenceIndex Int      @default(0) @map("turn_sequence_index")
  replicaCount      Int      @default(0) @map("replica_count")
  replicaConfig     Json?    @map("replica_config")
  hostId            String?  @map("host_id")
  adminIds          String[] @default([]) @map("admin_ids")
  phaseToken        String?  @map("phase_token")
  phaseDeadline     DateTime? @map("phase_deadline")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  participants  LiveBattleParticipant[]
  judges        LiveBattleJudge[]
  spectators    LiveBattleSpectator[]
  rubricVotes   LiveBattleRubricVote[]
  entryVotes    LiveBattlePatronEntryVote[]
  extraVotes    LiveBattlePatronExtraVote[]
  roundResults  LiveBattleRoundResult[]
  sessions      LiveBattleSession[]
  freeVotes     LiveBattleFreeVote[]
  roomVotes     LiveBattleRoomVote[]
  votingRosters LiveBattleVotingRoster[]

  @@map("live_battles")
}

model LiveBattleFreeVote {
  roomId     String @map("room_id")
  room       LiveBattle @relation(fields: [roomId], references: [id], onDelete: Cascade)
  replica    Int
  round      Int
  judgeId    String @map("judge_id")
  judgeName  String @map("judge_name")
  mc1Id      String @map("mc1_id")
  mc2Id      String @map("mc2_id")
  votedForId String @map("voted_for_id")

  @@id([roomId, replica, round, judgeId])
  @@map("live_battle_free_votes")
}

model LiveBattleRoomVote {
  roomId     String @map("room_id")
  room       LiveBattle @relation(fields: [roomId], references: [id], onDelete: Cascade)
  replica    Int
  round      Int
  voterId    String @map("voter_id")
  voterName  String @map("voter_name")
  mc1Id      String @map("mc1_id")
  mc2Id      String @map("mc2_id")
  votedForId String @map("voted_for_id")

  @@id([roomId, replica, round, voterId])
  @@map("live_battle_room_votes")
}

model LiveBattleVotingRoster {
  roomId   String @map("room_id")
  room     LiveBattle @relation(fields: [roomId], references: [id], onDelete: Cascade)
  replica  Int
  round    Int
  voterIds String[] @map("voter_ids")

  @@id([roomId, replica, round])
  @@map("live_battle_voting_rosters")
}

model LiveBattleSession {
  roomId    String     @map("room_id")
  room      LiveBattle @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tokenHash String     @map("token_hash")
  userId    String     @map("user_id")
  alias     String
  roles     String[]   @default([])
  expiresAt DateTime   @map("expires_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@id([roomId, tokenHash])
  @@index([expiresAt])
  @@map("live_battle_sessions")
}

model LiveBattleParticipant {
  id           String    @id @default(cuid())
  roomId       String    @map("room_id")
  room         LiveBattle @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId       String    @map("user_id")
  name         String
  alias        String
  isActive     Boolean   @default(false) @map("is_active")
  currentScore Int       @default(0) @map("current_score")
  roundsWon    Int       @default(0) @map("rounds_won")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@unique([roomId, userId])
  @@index([roomId])
  @@map("live_battle_participants")
}

model LiveBattleJudge {
  id        String    @id @default(cuid())
  roomId    String    @map("room_id")
  room      LiveBattle @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String    @map("user_id")
  alias     String
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([roomId, userId])
  @@index([roomId])
  @@map("live_battle_judges")
}

model LiveBattleSpectator {
  id        String    @id @default(cuid())
  roomId    String    @map("room_id")
  room      LiveBattle @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String    @map("user_id")
  alias     String
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([roomId, userId])
  @@index([roomId])
  @@map("live_battle_spectators")
}

model LiveBattleRubricVote {
  id        String    @id @default(cuid())
  roomId    String    @map("room_id")
  room      LiveBattle @relation(fields: [roomId], references: [id], onDelete: Cascade)
  judgeId   String    @map("judge_id")
  judgeName String    @map("judge_name")
  round     Int
  replica   Int       @default(0)
  mc1Id     String    @map("mc1_id")
  mc2Id     String    @map("mc2_id")
  mc1Scores Json      @map("mc1_scores")
  mc2Scores Json      @map("mc2_scores")
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([roomId, replica, round, judgeId], map: "live_battle_rubric_scope_key")
  @@index([roomId, round])
  @@map("live_battle_rubric_votes")
}

model LiveBattlePatronEntryVote {
  id         String    @id @default(cuid())
  roomId     String    @map("room_id")
  room       LiveBattle @relation(fields: [roomId], references: [id], onDelete: Cascade)
  judgeId    String    @map("judge_id")
  judgeName  String    @map("judge_name")
  round      Int
  replica    Int       @default(0)
  entryIndex Int       @map("entry_index")
  mcId       String    @map("mc_id")
  points     Int
  createdAt  DateTime  @default(now()) @map("created_at")

  @@unique([roomId, replica, round, mcId, entryIndex, judgeId], map: "live_battle_entry_scope_key")
  @@index([roomId, round, mcId, entryIndex])
  @@map("live_battle_patron_entry_votes")
}

model LiveBattlePatronExtraVote {
  id        String    @id @default(cuid())
  roomId    String    @map("room_id")
  room      LiveBattle @relation(fields: [roomId], references: [id], onDelete: Cascade)
  judgeId   String    @map("judge_id")
  judgeName String    @map("judge_name")
  round     Int
  replica   Int       @default(0)
  mc1Id     String    @map("mc1_id")
  mc2Id     String    @map("mc2_id")
  mc1Extra  Int       @map("mc1_extra")
  mc2Extra  Int       @map("mc2_extra")
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([roomId, replica, round, judgeId], map: "live_battle_extra_scope_key")
  @@index([roomId, round])
  @@map("live_battle_patron_extra_votes")
}

model LiveBattleRoundResult {
  id         String    @id @default(cuid())
  roomId     String    @map("room_id")
  room       LiveBattle @relation(fields: [roomId], references: [id], onDelete: Cascade)
  round      Int
  replica    Int       @default(0)
  winnerId   String?   @map("winner_id")
  scores     Json
  judgeVotes Json      @map("judge_votes")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@unique([roomId, replica, round], map: "live_battle_result_scope_key")
  @@index([roomId])
  @@map("live_battle_round_results")
}

model Tournament {
  id        String   @id
  name      String
  logo      String?  @map("logo")
  organizer String?  @map("organizer")
  type      String   @map("type")
  capacity  Int      @map("capacity")
  status    String   @default("setup") @map("status")
  data      Json     @map("data")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("tournaments")
}
