# Base de datos
DATABASE_URL="postgresql://freestyle:freestyle123@127.0.0.1:5433/freestyle"

# Contraseña de Postgres en desarrollo (si la cambias, actualiza también DATABASE_URL).
POSTGRES_PASSWORD=freestyle123

# Contraseña de Postgres en producción (la usa docker-compose.prod.yml).
DB_PASSWORD=""

# JWT
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Inventario privado: generar una clave aleatoria de al menos 32 caracteres.
INVENTORY_ADMIN_TOKEN=""

# En producción: secreto aleatorio independiente y orígenes HTTPS separados por comas.
SESSION_HASH_SALT=""
ALLOWED_ORIGINS=""

# Servidor WebSocket
WS_PORT=3001
NEXT_PUBLIC_WS_URL="http://localhost:3001"
